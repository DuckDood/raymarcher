#define toShapeCombineIndex(i) (i | (1<<31))

const int renderCombinationCount = 6;
renderCombination combinations[6] = renderCombination[6](
		// setup initialize scene
		renderCombination(0, 0, COMBINE_TYPE_MIN, 0.0, 1.0, 1.0, 0u, 0),

		renderCombination(2, 1, COMBINE_TYPE_MIN, 0.5, 1.0, 1.0, 0u, 1),

		renderCombination(3, 4, COMBINE_TYPE_MAX, 0.2, 1.0, -1.0, 1u, 2),

		renderCombination(toShapeCombineIndex(2), 4, COMBINE_TYPE_MIN, 0.0, 1.0, 1.0, 0u, 2),

		renderCombination(toShapeCombineIndex(1), toShapeCombineIndex(0), COMBINE_TYPE_MIN, 0.0, 1.0, 1.0, 0u, 0),
		renderCombination(toShapeCombineIndex(2), toShapeCombineIndex(0), COMBINE_TYPE_MIN, 0.0, 1.0, 1.0, 0u, 0)
		);


vec2 smin( float a, float b, float k ) { // from https://iquilezles.org/articles/smin/
	float h = 1.0 - min( abs(a-b)/(6.0*k), 1.0 );
	float w = h*h*h;
	float m = w*0.5;
	float s = w*k; 
	return (a<b) ? vec2(a-s,m) : vec2(b-s,1.0-m);
}

vec2 smax( float a, float b, float k ) { // from https://iquilezles.org/articles/smin/
	vec2 imin = smin(-a, -b, k);
	return vec2(-imin.x, imin.y);
}

float distToScene(vec3 position) {
	//float dist = 1000.0;
	/*for(int i = 0; i < renderCombinationCount; i++) {
		switch(combinations[i].type) {
			case COMBINE_TYPE_MIN:
				float dist1 = getShapeDistance(position, shapes[combinations[i].index1]);
				float dist2 = getShapeDistance(position, shapes[combinations[i].index2]);
				dist = smin(dist1, dist2, combinations[i].smoothingValue).x;
				break;
		}
	}*/
	/*for(int i = 0; i < shapeCount; i++) {
		dist = min(dist, getShapeDistance(position, shapes[i]));
	}*/
	float distances[8]; // for some reason when this gets bigger it really slows down webgl
	int distanceTop = 0;
	for(int i = 0; i < renderCombinationCount; i++) {
		int bitwiseFactor = 1 << 31;

		bool indexAlreadyCombined1 = (combinations[i].index1 & bitwiseFactor) != 0;
		bool indexAlreadyCombined2 = (combinations[i].index2 & bitwiseFactor) != 0;

		int index1 = combinations[i].index1 & (~bitwiseFactor);
		int index2 = combinations[i].index2 & (~bitwiseFactor);

		float dist1, dist2;
		if(!indexAlreadyCombined1) {
			dist1 = getShapeDistance(position, shapes[index1]) * combinations[i].mult1;
		} else {
			dist1 = distances[index1] * combinations[i].mult1;
		}

		if(!indexAlreadyCombined2) {
			dist2 = getShapeDistance(position, shapes[index2]) * combinations[i].mult2;
		} else {
			dist2 = distances[index2] * combinations[i].mult2;
		}

		switch(combinations[i].type) {
			case COMBINE_TYPE_MAX:
				distances[combinations[i].outIndex] = smax(dist1, dist2, combinations[i].smoothingValue).x;
				break;
			case COMBINE_TYPE_MIN:
				distances[combinations[i].outIndex] = smin(dist1, dist2, combinations[i].smoothingValue).x;
				break;
		}
	}
	return distances[0];

	//return d;
}

vec3 sceneCol(vec3 position) {
	vec4 colors[8];
	float distances[8];
	for(int i = 0; i < renderCombinationCount; i++) {
		int bitwiseFactor = 1 << 31;

		bool indexAlreadyCombined1 = (combinations[i].index1 & bitwiseFactor) != 0;
		bool indexAlreadyCombined2 = (combinations[i].index2 & bitwiseFactor) != 0;

		int index1 = combinations[i].index1 & (~bitwiseFactor);
		int index2 = combinations[i].index2 & (~bitwiseFactor);

		float dist1, dist2;
		vec4 color1, color2;
		if(!indexAlreadyCombined1) {
			dist1 = getShapeDistance(position, shapes[index1]) * combinations[i].mult1;
			color1 = shapes[index1].color;
		} else {
			dist1 = distances[index1] * combinations[i].mult1;
			color1 = colors[index1];
		}

		if(!indexAlreadyCombined2) {
			dist2 = getShapeDistance(position, shapes[index2]) * combinations[i].mult2;
			color2 = shapes[index2].color;
		} else {
			dist2 = distances[index2] * combinations[i].mult2;
			color2 = colors[index2];
		}

		switch(combinations[i].materialCombination) {
			case 1u:
				color2 = color1;
				break;
			case 2u:
				color1 = color2;
				break;
			case 3u:
				vec4 colorTemp;
				colorTemp = color1;
				color1 = color2;
				color2 = colorTemp;
				break;
		}

		switch(combinations[i].type) {
			case COMBINE_TYPE_MAX:
				distances[combinations[i].outIndex] = smax(dist1, dist2, combinations[i].smoothingValue).x;
				colors[combinations[i].outIndex] = mix(color1, color2, smax(dist1, dist2, combinations[i].smoothingValue).y);
				break;
			case COMBINE_TYPE_MIN:
				distances[combinations[i].outIndex] = smin(dist1, dist2, combinations[i].smoothingValue).x;
				colors[combinations[i].outIndex] = mix(color1, color2, smin(dist1, dist2, combinations[i].smoothingValue).y);
				break;
		}
	}
	return colors[0].xyz;

}


vec3 getNormal(float distPosX, float distNegX, float distPosY, float distNegY, float distPosZ, float distNegZ) {
	return normalize(vec3(distPosX-distNegX, distPosY-distNegY, distPosZ-distNegZ));
}

struct rayHitInfo {
	vec3 position;
	vec3 normal;
	bool hit;
};

rayHitInfo march(camRay ray) {
	bool hit = false;
	vec3 normal = vec3(0);
	int step_count = 0;
	for(; true; step_count++) {
		//if(step_count > 500) break;
		float dist = distToScene(ray.position);

		if(dist < 0.001) {
			hit = true;

			float step = 0.001;
			float distToShapePosX = distToScene(ray.position + vec3(step, 0.0, 0.0));
			float distToShapePosY = distToScene(ray.position + vec3(0.0, step, 0.0));
			float distToShapePosZ = distToScene(ray.position + vec3(0.0, 0.0, step));

			float distToShapeNegX = distToScene(ray.position - vec3(step, 0.0, 0.0));
			float distToShapeNegY = distToScene(ray.position - vec3(0.0, step, 0.0));
			float distToShapeNegZ = distToScene(ray.position - vec3(0.0, 0.0, step));


			normal = getNormal(distToShapePosX, distToShapeNegX, distToShapePosY, distToShapeNegY, distToShapePosZ, distToShapeNegZ);
			//t = distToShapeFactor;
			break;
		}
		if(dist > 100.0) {
			break;
		}

		ray.position += ray.direction * dist;
	}

	rayHitInfo info;
	info.hit = hit;
	info.position = ray.position;
	info.normal = normal;

	return info;
}

void main() {
	//FragColor = vec4(float(shapeCount)/10.0, 0.0, 0.0, 1.0);
	//return;
	float aspectRatio = uResolution.x / uResolution.y;
	camRay ray;
	ray.position = uCamPosition;
	ray.direction = normalize((uCamRotationMatrix * vec4((gl_FragCoord.xy / uResolution * 2.0 - 1.0) * vec2(aspectRatio, 1.0), 1.0, 0.0)).xyz);

	/*bool hit = false;
	vec3 normal = vec3(0);
	float t = 0.5;
	int step_count = 0;
	for(; true; step_count++) {
		//if(step_count > 500) break;
		float dist = distToScene(ray.position);

		if(dist < 0.001) {
