vec2 smin( float a, float b, float k ) { // from https://iquilezles.org/articles/smin/
	float h = 1.0 - min( abs(a-b)/(6.0*k), 1.0 );
	float w = h*h*h;
	float m = w*0.5;
	float s = w*k; 
	return (a<b) ? vec2(a-s,m) : vec2(b-s,1.0-m);
}

vec2 smax( float a, float b, float k ) { // from https://iquilezles.org/articles/smin/
	vec2 imin = smin(-a, -b, k);
	return vec2(-imin.x, imin.y);
}

uniform float uTextureLength;

#define positionToTexCoord(x) vec3(((x / uTextureLength) + 0.5))

float distToSceneTex(vec3 position) {
	vec3 texCoord = positionToTexCoord(position);//vec3(((position / textureLength) + 0.5));
	if(
			texCoord.x > 1 || texCoord.x < 0 ||
			texCoord.y > 1 || texCoord.y < 0 ||
			texCoord.z > 1 || texCoord.z < 0 
			) {
		return 1000;
	}
	return texture(distanceField, texCoord).x;
}

float distToScene(vec3 position) {

#define highestBit8 (1 << 7)
#define highestBits8 ((1 << 7) | (1<<6))
#define opToByte(x) (x >> 24)

#define paramsToOp(type, out, boolean, op1Type, op2Type, sized, mixType) (type << 31) | (out << 29) | (boolean << 27) | (op1Type << 26) | (op2Type << 25) | (sized << 24) | (mixType << 22)


#define opType(x) ((opToByte(x) & highestBit8) >> 7)
#define opOut(x) ((opToByte(x) & (highestBits8>>1)) >> 5)
#define opBool(x) ((opToByte(x) & (highestBits8>>3)) >> 3)

#define opOp1Type(x) ((opToByte(x) & (highestBit8>>5)) >> 2)
#define opOp2Type(x) ((opToByte(x) & (highestBit8>>6)) >> 1)

#define opSized(x) ((opToByte(x) & (highestBit8>>7)) >> 0)

#define opMixType(x) ((opToByte((x<<8))&highestBits8)>>6)

	vec4 distances = vec4(0.0);


	float tempDist = 0.0;

	for(int i = 0; i < opCount; i++) {
		renderOperation op = operations[i];

		ivec4 eqVec = ivec4(0, 1, 2, 3);

		vec4 operand1 = vec4(equal(ivec4(op.operand1), eqVec));
		vec4 operand2 = vec4(equal(ivec4(op.operand2), eqVec));


		vec4 outVec = vec4(equal(ivec4(opOut(op.operation)), eqVec));

		float dist1;
		float dist2;
		switch(opOp1Type(op.operation)) {
			case 0: // shape
				dist1 = getShapeDistance(position, shapes[op.operand1]);
				break;
			case 1: // distance
				dist1 = dot(distances, operand1);
				break;
		}
		switch(opOp2Type(op.operation)) {
			case 0: // shape
				dist2 = getShapeDistance(position, shapes[op.operand2]);
				break;
			case 1: // distance
				dist2 = dot(distances, operand2);
				break;
		}
		switch(opBool(op.operation)) {
			case 0: // union
				tempDist = smin(dist1, dist2, op.smoothing).x;
				break;
			case 1: // difference
				tempDist = smax(dist1, -dist2, op.smoothing).x;
				break;
			case 2: // intersection
				tempDist = smax(dist1, dist2, op.smoothing).x;
				break;
		}

		distances *= (1.0-outVec);
		distances += outVec * tempDist;
	}

	return distances.x;
	/*distance0 = getShapeDistance(position, shapes[1]);
	distance1 = getShapeDistance(position, shapes[2]);
	distance0 = smin(distance0, distance1, 0.5).x;
	distance1 = getShapeDistance(position, shapes[3]);
	distance2 = getShapeDistance(position, shapes[4]);
	distance1 = smax(distance1, -distance2, 0.5).x;

	distance0 = smin(distance0, distance1, 0.0).x;

	distance1 = getShapeDistance(position, shapes[4]);
	distance0 = smin(distance0, distance1, 0.0).x;*/

	//distance0 = smin(distance2, distance3, 0.0).x;
}

vec3 sceneCol(vec3 position) {
	vec4 distances = vec4(0.0);

	vec3 colors[4];


	float tempDist = 0.0;
	vec3 tempCol;

	for(int i = 0; i < opCount; i++) {
		renderOperation op = operations[i];

		ivec4 eqVec = ivec4(0, 1, 2, 3);

		vec4 operand1 = vec4(equal(ivec4(op.operand1), eqVec));
		vec4 operand2 = vec4(equal(ivec4(op.operand2), eqVec));


		vec4 outVec = vec4(equal(ivec4(opOut(op.operation)), eqVec));

		float dist1;
		float dist2;

		vec3 col1;
		vec3 col2;
		switch(opOp1Type(op.operation)) {
			case 0: // shape
				dist1 = getShapeDistance(position, shapes[op.operand1]);
				col1 = shapes[op.operand1].color.xyz;
				break;
			case 1: // distance
				dist1 = dot(distances, operand1);
				col1 = colors[op.operand1];
				break;
		}
		switch(opOp2Type(op.operation)) {
			case 0: // shape
				dist2 = getShapeDistance(position, shapes[op.operand2]);
				col2 = shapes[op.operand2].color.xyz;
				break;
			case 1: // distance
				dist2 = dot(distances, operand2);
				col2 = colors[op.operand2];
				break;
		}
		switch(opMixType(op.operation)) {
			case 1:
				col2 = col1;
				break;
			case 2:
				col1 = col2;
				break;
		}
		switch(opBool(op.operation)) {
			case 0: // union
				tempDist = smin(dist1, dist2, op.smoothing).x;
				tempCol = mix(col1, col2, smin(dist1, dist2, op.smoothing).y);
				break;
			case 1: // difference
				tempDist = smax(dist1, -dist2, op.smoothing).x;
				tempCol = mix(col1, col2, smax(dist1, -dist2, op.smoothing).y);
				break;
			case 2: // intersection
				tempDist = smax(dist1, dist2, op.smoothing).x;
				tempCol = mix(col1, col2, smax(dist1, dist2, op.smoothing).y);
				break;
		}

		distances *= (1.0-outVec);
		distances += outVec * tempDist;

		colors[opOut(op.operation)] = tempCol;
	}

	//return distances.x;
	return colors[0];
}


vec3 getNormal(float distPosX, float distNegX, float distPosY, float distNegY, float distPosZ, float distNegZ) {
	return normalize(vec3(distPosX-distNegX, distPosY-distNegY, distPosZ-distNegZ));
}

vec3 getNormalFromPos(vec3 position, float dist, float step) {
			float distToShapePosX = distToScene(position + vec3(step, 0.0, 0.0));
			float distToShapePosY = distToScene(position + vec3(0.0, step, 0.0));
			float distToShapePosZ = distToScene(position + vec3(0.0, 0.0, step));

			dist = distToScene(position);

			return getNormal(distToShapePosX, dist, distToShapePosY, dist, distToShapePosZ, dist);
}

vec3 getNormalFromTex(vec3 position) {
	vec3 texCoord = vec3(((position / uTextureLength) + 0.5));
	if(
			texCoord.x > 1 || texCoord.x < 0 ||
			texCoord.y > 1 || texCoord.y < 0 ||
			texCoord.z > 1 || texCoord.z < 0 
			) {
		return vec3(0);
	}
	return normalize(texture(distanceField, texCoord).rgb);

}
vec3 getNormalFromPosTex(vec3 position) {
	vec3 texCoord = positionToTexCoord(position);
	if(
			texCoord.x > 1 || texCoord.x < 0 ||
			texCoord.y > 1 || texCoord.y < 0 ||
			texCoord.z > 1 || texCoord.z < 0 
			) {
		return vec3(0);
	}

	float step = 1/128.;


	float distPosX = texture(distanceField, texCoord + vec3(step, 0, 0)).x;
	float distPosY = texture(distanceField, texCoord + vec3(0, step, 0)).x;
	float distPosZ = texture(distanceField, texCoord + vec3(0, 0, step)).x;

	float distNegX = texture(distanceField, texCoord - vec3(step, 0, 0)).x;
	float distNegY = texture(distanceField, texCoord - vec3(0, step, 0)).x;
	float distNegZ = texture(distanceField, texCoord - vec3(0, 0, step)).x;


	//return getNormal(distPosX, dist, distPosY, dist, distPosZ, dist);
	return getNormal(distPosX, distNegX, distPosY, distNegY, distPosZ, distNegZ);

}

struct rayHitInfo {
	vec3 position;
	float finalDist;
	bool hit;
};


rayHitInfo march(camRay ray) {
	bool hit = false;
	int step_count = 0;
	float finalDist = 0.0;
	float belowHit = 0.001;
	for(; true; step_count++) {
		/*if(step_count > 127) {
			belowHit = 0.01;
		}*/
		belowHit = float(step_count) / 12700.f + 0.001;
		float dist = distToSceneTex(ray.position);

		if(dist < belowHit) {
			hit = true;

			/*float step = 0.001;
			float distToShapePosX = distToScene(ray.position + vec3(step, 0.0, 0.0));
			float distToShapePosY = distToScene(ray.position + vec3(0.0, step, 0.0));
			float distToShapePosZ = distToScene(ray.position + vec3(0.0, 0.0, step));

			/*float distToShapeNegX = distToScene(ray.position - vec3(step, 0.0, 0.0));
			float distToShapeNegY = distToScene(ray.position - vec3(0.0, step, 0.0));
			float distToShapeNegZ = distToScene(ray.position - vec3(0.0, 0.0, step));*/


			//normal = getNormal(distToShapePosX, distToShapeNegX, distToShapePosY, distToShapeNegY, distToShapePosZ, distToShapeNegZ);
			//normal = getNormal(distToShapePosX, dist, distToShapePosY, dist, distToShapePosZ, dist);*/
			//t = distToShapeFactor;
			finalDist = dist;
			break;
		}
		if(dist > 100.0) {
			break;
		}
		/*if(step_count > 127) {
			break;
		}*/

		ray.position += ray.direction * dist;
	}

	rayHitInfo info;
	info.hit = hit;
	info.position = ray.position;
	info.finalDist = finalDist;

	return info;
}

